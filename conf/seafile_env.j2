TIME_ZONE={{ time_zone }}
JWT_PRIVATE_KEY={{ jwt_private }}
SITE_ROOT={{ path2 }}

SEAFILE_SERVER_PROTOCOL=https
SEAFILE_SERVER_HOSTNAME={{ domain }}

# Seafile 13's fileserver reads notification support from env, not seafile.conf.
ENABLE_NOTIFICATION_SERVER=true
INNER_NOTIFICATION_SERVER_URL=http://127.0.0.1:{{ port_notificationserver }}

# Database
SEAFILE_MYSQL_DB_HOST=127.0.0.1
SEAFILE_MYSQL_DB_PORT=3306
SEAFILE_MYSQL_DB_USER={{ db_user }}
SEAFILE_MYSQL_DB_PASSWORD={{ db_pwd }}
SEAFILE_MYSQL_DB_CCNET_DB_NAME=ccnetdb
SEAFILE_MYSQL_DB_SEAFILE_DB_NAME={{ db_name }}
SEAFILE_MYSQL_DB_SEAHUB_DB_NAME=seahubdb

# Seadoc
ENABLE_SEADOC=true
SEADOC_SERVER_URL=https://{{ domain }}{{ path2 }}sdoc

# Note we are setting here memcached but in reality it's just to disable cache.
# In are in case when:
# We use redis for seahub and it's epxected to work
# WE don't use any cache for seafile-server because
# - We can't specify the db ID for redis cf https://github.com/haiwen/seafile-server/pull/805
# - We memcached is note supported after analizing the code, the configuration is taken into account only if redis is set as provider
CACHE_PROVIDER=memcached
